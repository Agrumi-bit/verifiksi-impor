// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  role String? @default("SURVEYOR")

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  username   String?   @unique
  phone      String?
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  assignments                      Assignment[]                 @relation("SurveyorAssignments")
  verifikatorAssignments           Assignment[]                 @relation("VerifikatorAssignments")
  technicalReviewerAssignments     Assignment[]                 @relation("TechnicalReviewerAssignments")
  documentUploads                  CompanyDocumentVersion[]
  documentVerifications            CompanyDocumentVersion[]     @relation("DocumentVerifiedBy")
  applicationDocumentUploads       ApplicationDocumentVersion[]
  applicationDocumentVerifications ApplicationDocumentVersion[] @relation("ApplicationDocumentVerifiedBy")

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Set by better-auth's admin plugin while an admin is impersonating this
  // session's user — holds the impersonating admin's own user id.
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  ADMINISTRATIVE_REVIEW
  SURVEY_SCHEDULED
  FIELD_VERIFICATION
  VERIFICATION
  TECHNICAL_REVIEW
  COMPLIANCE_REVIEW
  REPORT_GENERATION
  COMPLETED
  RETURNED
  REJECTED
  WITHDRAWN
}

model Application {
  id                  String            @id @default(cuid())
  applicationNumber   String            @unique
  verificationType    String
  applicationCategory String
  status              ApplicationStatus @default(SUBMITTED)
  payload             Json
  companyId           String?
  company             Company?          @relation(fields: [companyId], references: [id])
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  assignments      Assignment[]
  messages         ApplicationMessage[]
  documentVersions ApplicationDocumentVersion[]

  // Customer Relation Workspace's own operational tracking — intentionally
  // separate from `status` (ApplicationStatus) above, which is driven by the
  // company-facing withdraw flow and has different, narrower semantics.
  crOutcome               String?
  crDocumentVerifications Json?
  crFollowUpDate          DateTime?
  crNotes                 String?

  @@index([companyId])
  @@map("application")
}

enum MessageDirection {
  IN
  OUT
  SYSTEM
}

model ApplicationMessage {
  id            String           @id @default(cuid())
  applicationId String
  application   Application      @relation(fields: [applicationId], references: [id])
  direction     MessageDirection
  text          String
  createdAt     DateTime         @default(now())

  @@index([applicationId])
  @@map("application_message")
}

enum PartnerType {
  INDUSTRI
  NON_INDUSTRI
}

enum PartnerStatus {
  ACTIVE
  INACTIVE
}

model Partner {
  id        String        @id @default(cuid())
  companyId String
  company   Company       @relation(fields: [companyId], references: [id])
  type      PartnerType
  status    PartnerStatus @default(ACTIVE)

  contractNumber       String
  contractStartDate    DateTime
  contractEndDate      DateTime
  contractDocumentPath String?

  // The API-U company that registered this mitra relationship (Company Workspace's own
  // "Partner Companies" list) — distinct from `companyId` above, which is the mitra's own
  // identity. Nullable because Partner rows created via the admin Partner Management module
  // have no owner (they're the pre-existing global registry every company's application
  // wizard can already pick from via /api/partners?type=INDUSTRI).
  ownerCompanyId String?
  ownerCompany   Company? @relation("PartnerOwner", fields: [ownerCompanyId], references: [id])

  // API-U companies admin has flagged as related to / using this mitra — set explicitly by
  // admin when creating the Partner (many-to-many: one partner can serve several API-U
  // companies, and one company can relate to several partners). Distinct from `ownerCompanyId`
  // (who registered this specific Partner row from Company Workspace) and from the
  // `partnerIndustriEntries` a company toggles on per-application — this is admin's own
  // curated "PERUSAHAAN API-U TERKAIT" list, not derived from application data.
  relatedCompanies Company[] @relation("PartnerRelatedCompanies")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([type])
  @@index([ownerCompanyId])
  @@map("partner")
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
}

model Company {
  id     String        @id @default(cuid())
  status CompanyStatus @default(ACTIVE)

  logoPath           String?
  apiType            String?
  companyName        String
  companyType        String
  investmentStatus   String
  companyEmail       String
  companyPhone       String
  companyWebsite     String?
  contactFullName    String
  contactDesignation String
  contactEmail       String
  contactPhone       String
  contacts           Json    @default("[]")

  addressJalan     String?
  addressDesa      String?
  addressKecamatan String?
  addressKota      String?
  addressProvinsi  String?
  addressKodePos   String?

  nibNumber                String    @unique
  nibIssueDate             DateTime
  nibDocumentPath          String
  kbliEntries              Json
  kbliDocumentPath         String
  notarialDeedNumber       String
  notarialDeedIssueDate    DateTime
  notarialIssuingAuthority String
  notarialAmendmentInfo    String?
  notarialDocumentPath     String

  notarialAmendmentNumber    String?
  notarialAmendmentDate      DateTime?
  notarialAmendmentAuthority String?
  notarialAmendmentDocPath   String?

  skNumber       String?
  skDate         DateTime?
  skDocumentPath String?

  npwpNumber       String?
  npwpIssuer       String?
  npwpDocumentPath String?

  companyAge      String?
  taxProofs       Json      @default("[]")
  sktNumber       String?
  sktIssuer       String?
  sktDate         DateTime?
  sktDocumentPath String?

  locations Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  applications     Application[]
  merks            Merk[]
  partners         Partner[]
  ownedPartners    Partner[]                 @relation("PartnerOwner")
  relatedToPartners Partner[]                @relation("PartnerRelatedCompanies")
  documentVersions CompanyDocumentVersion[]

  @@map("company")
}

// Append-only — never updated or deleted. "Version" for a document field is
// derived from the row count, "current" is the latest row. Two write paths
// insert into this: POST /api/companies (initial creation) and PATCH
// /api/company-workspace/profile (self-service legal/tax edits) — see
// src/modules/company/document-versions.ts.
enum DocumentVerificationStatus {
  NOT_YET_VERIFIED
  VERIFIED
  NEED_REVISION
  REJECTED
  NOT_APPLICABLE
  EXPIRED
}

model CompanyDocumentVersion {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  fieldKey     String
  version      Int
  path         String?
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  verificationStatus DocumentVerificationStatus @default(NOT_YET_VERIFIED)
  verifiedById       String?
  verifiedBy         User?                      @relation("DocumentVerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt         DateTime?
  // Which review stage actually set the current `verificationStatus` — "CR" (Customer Relation's
  // administrative check) vs "VERIFIKATOR" (the authoritative technical review). Null on legacy rows
  // predating this distinction, treated as "VERIFIKATOR" for display since that's all that existed then.
  verifiedByRole     String?
  rejectionNote      String?
  checklistResult    Json?

  @@unique([companyId, fieldKey, version])
  @@index([companyId, fieldKey])
  @@map("company_document_version")
}

// Structural mirror of CompanyDocumentVersion for documents that only exist
// inside an Application's own payload (facility proofs, VKI surat
// pernyataan, etc.) — see src/modules/applications/document-versions.ts.
model ApplicationDocumentVersion {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])
  fieldKey      String
  version       Int
  path          String?
  uploadedById  String?
  uploadedBy    User?       @relation(fields: [uploadedById], references: [id])
  createdAt     DateTime    @default(now())

  verificationStatus DocumentVerificationStatus @default(NOT_YET_VERIFIED)
  verifiedById       String?
  verifiedBy         User?                      @relation("ApplicationDocumentVerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt         DateTime?
  // See CompanyDocumentVersion.verifiedByRole — same "CR" vs "VERIFIKATOR" distinction, mirrored here.
  verifiedByRole     String?
  rejectionNote      String?
  checklistResult    Json?

  @@unique([applicationId, fieldKey, version])
  @@index([applicationId, fieldKey])
  @@map("application_document_version")
}

model CompanyDraft {
  id          String   @id @default(cuid())
  createdById String
  payload     Json
  currentStep Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // An admin can have several "Tambah Perusahaan" wizards in progress at
  // once — no longer one draft slot per user, so createdById is indexed for
  // the drafts-list query instead of being a unique key.
  @@index([createdById])
  @@map("company_draft")
}

model ApplicationDraft {
  id          String   @id @default(cuid())
  createdById String   @unique
  payload     Json
  currentStep Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("application_draft")
}

enum MerkOwnershipType {
  MILIK_SENDIRI
  LISENSI
}

enum MerkStatus {
  ACTIVE
  INACTIVE
  // Saved via "Simpan Draft" mid-wizard — skips full validation, only
  // brandName is guaranteed. Never set by the ACTIVE/INACTIVE toggle.
  DRAFT
}

// Step 1 "Jenis Impor" — mirrors the Application wizard's own Barang Konsumsi /
// Bahan Baku split, reused here to drive which documents Step 5 requires.
enum MerkImportGoodsType {
  BARANG_KONSUMSI
  BAHAN_BAKU
}

// Step 2 "Jenis Sertifikat" — TANDA_DAFTAR_MEREK takes a single registration
// date (registrationDate); the others take a validity range (registrationDate
// as start, registrationExpiryDate as end).
enum MerkCertificateType {
  TANDA_DAFTAR_MEREK
  SERTIFIKAT_MEREK_TERDAFTAR
  SERTIFIKAT_INTERNASIONAL
  LAINNYA
}

// Step 4 — whether the registering company (the importer) is itself the brand
// owner, or the brand owner is a separate company and one or more distinct
// importers are named instead (see MerkImporter).
enum MerkImporterRelation {
  BRAND_OWNER_IS_IMPORTER
  SEPARATE_IMPORTERS
}

// --- Step 2 "Kepemilikan & Perwakilan" (ownership/representation redesign) ---

enum MerkOwnerLocation {
  DOMESTIC
  FOREIGN
}

enum MerkOwnerType {
  COMPANY
  INDIVIDUAL
}

enum MerkForeignEntityType {
  COMPANY
  ORGANIZATION
  INDIVIDUAL
  OTHER
}

// Domestic-owner scenario: how the applicant API-U company relates to the
// (Indonesian) brand owner.
enum MerkApiuRelationship {
  APIU_IS_OWNER
  APIU_IS_IMPORTER
}

// Foreign-owner scenario: how the brand is represented in Indonesia.
enum MerkRepresentationType {
  APIU_OFFICIAL_REPRESENTATIVE
  OTHER_OFFICIAL_REPRESENTATIVE
  APPOINTED_IMPORTER
}

enum MerkAgreementType {
  LISENSI
  SUBLISENSI
}

// Who issued the importer appointment letter (Surat Penunjukan Importir).
enum MerkAppointmentSource {
  BRAND_OWNER
  OFFICIAL_REPRESENTATIVE
}

model Merk {
  id     String     @id @default(cuid())
  status MerkStatus @default(ACTIVE)

  brandName                String
  productCategory          String
  countryOfOrigin          String
  // Nullable: Step 2's "Tidak mempunyai sertifikat" path (hasCertificate = false)
  // legitimately has no certificate number/document.
  registrationNumber       String?
  registrationDocumentPath String?

  // Nullable: predate this change on already-populated environments; the wizard
  // schema makes all three required for new rows.
  registrationIssuer     String?
  registrationDate       DateTime?
  registrationExpiryDate DateTime?

  // Step 1 additions — nullable: predate this change on already-populated environments.
  importGoodsType  MerkImportGoodsType?
  brandType        String?
  brandCategory    String?
  officialWebsite  String?
  contactEmail     String?
  brandDescription String?

  // Step 1 (drawer redesign) — hasCertificate/certificateType classify the
  // registrationNumber/Issuer/Date/DocumentPath fields above ("Jenis Bukti
  // Merek": SERTIFIKAT_MEREK_TERDAFTAR / TANDA_DAFTAR_MEREK /
  // SERTIFIKAT_INTERNASIONAL — LAINNYA stays a valid DB value but the
  // wizard no longer offers it). registrationIssuer ("Lembaga Penerbit") is
  // collected again by this flow; registrationExpiryDate remains unused
  // (single date, no expiry) but kept for rows written by the pre-drawer
  // wizard.
  hasCertificate  Boolean              @default(true)
  certificateType MerkCertificateType?
  trademarkClass    String?
  merekStatusLabel  String?
  logoPath          String?

  // ownershipType/brandOwnerName are legacy (pre-BrandOwner) fields, kept for
  // existing rows and still written by the API — derived from
  // importerRelation/brandOwnerId so old readers of this row keep working.
  ownershipType  MerkOwnershipType
  brandOwnerName String

  // Step 3 — nullable: legacy rows predate BrandOwner and only have brandOwnerName.
  brandOwnerId String?
  brandOwner   BrandOwner? @relation(fields: [brandOwnerId], references: [id])

  licenseAgreementNumber String?
  licenseStartDate       DateTime?
  licenseEndDate         DateTime?
  licenseDocumentPath    String?

  // Step 4/5 — legacy multi-importer model, superseded by MerkOwnership for
  // rows created by the current wizard; left non-destructively in place.
  importerRelation      MerkImporterRelation?
  importers             MerkImporter[]
  supportingDocuments   Json?

  // Step 2 (current wizard) — 1:1, see MerkOwnership.
  ownership MerkOwnership?

  // Step 3 (current wizard) — one row per uploaded requirement slot (see
  // getRequiredBrandDocuments) plus the repeatable Quality Test records.
  documents    BrandDocument[]
  qualityTests BrandQualityTest[]

  // Step 6 — when the submitter accepted the mandatory legal declaration.
  declarationAcceptedAt DateTime?

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([brandOwnerId])
  @@map("merk")
}

// One row per importer named in Step 4 when importerRelation is
// SEPARATE_IMPORTERS — each carries its own authorization document (surat
// kuasa/penunjukan dari pemilik merek), matching Step 5/6's "N importir
// dengan dokumen masing-masing".
model MerkImporter {
  id                        String   @id @default(cuid())
  merkId                    String
  merk                      Merk     @relation(fields: [merkId], references: [id], onDelete: Cascade)
  companyName               String
  authorizationDocumentPath String
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([merkId])
  @@map("merk_importer")
}

// Step 2 "Kepemilikan & Perwakilan" — one row per Merk, holding whichever
// subset of fields the selected scenario needs (see MERK_STEP_FIELD rules in
// src/modules/merk/schema.ts; unused fields for a given scenario stay null).
model MerkOwnership {
  id     String @id @default(cuid())
  merkId String @unique
  merk   Merk   @relation(fields: [merkId], references: [id], onDelete: Cascade)

  ownerLocation MerkOwnerLocation

  // --- Domestic owner (ownerLocation = DOMESTIC) ---
  ownerType      MerkOwnerType?
  ownerCompanyId String?
  ownerCompany   BrandOwner?    @relation("MerkOwnershipOwnerCompany", fields: [ownerCompanyId], references: [id])
  // ownerName/ownerAddress double as the domestic-individual owner's name/address
  // and the foreign owner's name/address — same concept, different scenario.
  ownerName      String?
  ownerAddress   String?

  relationshipWithApiu MerkApiuRelationship?

  // --- Foreign owner (ownerLocation = FOREIGN) ---
  foreignEntityType         MerkForeignEntityType?
  // Stored as a plain country name (matches countryOfOrigin's convention
  // elsewhere in this schema) despite the "CountryCode" name carried over
  // from the wizard's field naming.
  ownerCountryCode          String?
  foreignRegistrationNumber String?

  representationType              MerkRepresentationType?
  officialRepresentativeId         String?
  officialRepresentative           BrandOwner?             @relation("MerkOwnershipOfficialRepresentative", fields: [officialRepresentativeId], references: [id])

  // --- Lisensi/Sublisensi (representationType = APIU_OFFICIAL_REPRESENTATIVE) ---
  agreementType      MerkAgreementType?
  agreementNumber    String?
  agreementStartDate DateTime?
  agreementEndDate   DateTime?

  // --- Surat Penunjukan Importir (domestic apiu_is_importer, OTHER_OFFICIAL_REPRESENTATIVE, APPOINTED_IMPORTER) ---
  appointmentSource       MerkAppointmentSource?
  appointmentLetterNumber String?
  appointmentStartDate    DateTime?
  appointmentEndDate      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerCompanyId])
  @@index([officialRepresentativeId])
  @@map("merk_ownership")
}

// Step 3 "Dokumen Pendukung" — one row per uploaded requirement slot.
// `documentType` is a getRequiredBrandDocuments() requirement code (e.g.
// "trademark_evidence", "official_representative_appointment"); `category`
// mirrors that requirement's BrandDocumentRequirement.category. No DB-level
// uniqueness on (merkId, documentType): every slot is single-file by
// convention except "product_label_documentation", which the UI allows
// multiple rows for.
model BrandDocument {
  id             String    @id @default(cuid())
  merkId         String
  merk           Merk      @relation(fields: [merkId], references: [id], onDelete: Cascade)
  documentType   String
  category       String
  filePath       String
  fileName       String
  fileSize       Int
  documentNumber String?
  issueDate      DateTime?
  expiryDate     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([merkId])
  @@index([merkId, documentType])
  @@map("brand_document")
}

// Step 3 "Hasil Uji Mutu" — structured, repeatable (not a generic
// attachment). Links into the existing Commodity master data rather than
// duplicating a commodity picker.
model BrandQualityTest {
  id                  String             @id @default(cuid())
  merkId              String
  merk                Merk               @relation(fields: [merkId], references: [id], onDelete: Cascade)
  commodityGroupId    String
  commodityGroup      CommodityGroup     @relation(fields: [commodityGroupId], references: [id])
  commoditySubGroupId String?
  commoditySubGroup   CommoditySubGroup? @relation(fields: [commoditySubGroupId], references: [id])
  certificateNumber   String
  laboratoryName      String
  issueDate           DateTime
  expiryDate          DateTime?
  filePath            String
  fileName            String
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([merkId])
  @@index([commodityGroupId])
  @@index([commoditySubGroupId])
  @@map("brand_quality_test")
}

enum MasterDataStatus {
  ACTIVE
  INACTIVE
}

// "Mitra Pemilik Merek" registry searched in the Merk wizard's Step 3 — a
// standalone list (not the Company table) since a brand owner is frequently a
// foreign or unaffiliated company with no Company Workspace account of its own.
model BrandOwner {
  id            String           @id @default(cuid())
  status        MasterDataStatus @default(ACTIVE)
  name          String
  city          String?
  contactPerson String?
  contactEmail  String?
  contactPhone  String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  merks Merk[]

  // Step 2 (current wizard) — a BrandOwner row can be picked as the domestic
  // owner company, the foreign owner's official representative, or both
  // across different Merk registrations.
  ownershipAsOwnerCompany          MerkOwnership[] @relation("MerkOwnershipOwnerCompany")
  ownershipAsOfficialRepresentative MerkOwnership[] @relation("MerkOwnershipOfficialRepresentative")

  @@map("brand_owner")
}

model UnitOfMeasurement {
  id          String             @id @default(cuid())
  status      MasterDataStatus   @default(ACTIVE)
  name        String
  symbol      String
  description String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  hsCodes     HsCodeMasterData[]

  @@map("unit_of_measurement")
}

// Top of the hierarchy: Kelompok Industri > CommodityGroup > CommoditySubGroup. Nullable on
// CommodityGroup since existing rows predate this level — new rows are expected to set it (enforced
// in the create form/schema, not the DB), so legacy ungrouped rows aren't broken by a hard migration.
// Reference table for PLN's official tariff groups — Permen ESDM No. 7 Tahun 2024
// Lampiran I-VIII. tarifPerKwh stores the headline LWBP/flat Rp-per-kWh figure (block-tariff
// and WBP/K-factor detail goes in keterangan) — matches this codebase's convention of storing
// numeric wizard/reference fields as display strings rather than Decimal.
model ElectricityTariffMasterData {
  id          String           @id @default(cuid())
  status      MasterDataStatus @default(ACTIVE)
  kelompok    String
  golongan    String
  batasDaya   String
  tarifPerKwh String
  keterangan  String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("electricity_tariff_master_data")
}

model IndustryGroup {
  id              String           @id @default(cuid())
  status          MasterDataStatus @default(ACTIVE)
  name            String
  code            String
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  commodityGroups CommodityGroup[]

  @@map("industry_group")
}

model CommodityGroup {
  id              String              @id @default(cuid())
  status          MasterDataStatus    @default(ACTIVE)
  name            String
  code            String
  description     String?
  industryGroupId String?
  industryGroup   IndustryGroup?      @relation(fields: [industryGroupId], references: [id])
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  subGroups       CommoditySubGroup[]
  hsCodes         HsCodeMasterData[]
  brandQualityTests BrandQualityTest[]

  @@index([industryGroupId])
  @@map("commodity_group")
}

model CommoditySubGroup {
  id               String             @id @default(cuid())
  status           MasterDataStatus   @default(ACTIVE)
  name             String
  code             String
  description      String?
  commodityGroupId String
  commodityGroup   CommodityGroup     @relation(fields: [commodityGroupId], references: [id])
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  hsCodes          HsCodeMasterData[]
  brandQualityTests BrandQualityTest[]

  @@index([commodityGroupId])
  @@map("commodity_sub_group")
}

model KbliMasterData {
  id                 String           @id @default(cuid())
  status             MasterDataStatus @default(ACTIVE)
  code               String
  description        String
  category           String           @default("-")
  version            String           @default("KBLI 2020")
  deactivationReason String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([code, version])
  @@map("kbli_master_data")
}

model HsCodeMasterData {
  id                  String            @id @default(cuid())
  status              MasterDataStatus  @default(ACTIVE)
  hsCode              String
  description         String
  commodityGroupId    String
  commodityGroup      CommodityGroup    @relation(fields: [commodityGroupId], references: [id])
  commoditySubGroupId String
  commoditySubGroup   CommoditySubGroup @relation(fields: [commoditySubGroupId], references: [id])
  unitOfMeasurementId String
  unitOfMeasurement   UnitOfMeasurement @relation(fields: [unitOfMeasurementId], references: [id])
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  lartasImpor         LartasImpor[]

  @@index([commodityGroupId])
  @@index([commoditySubGroupId])
  @@index([unitOfMeasurementId])
  @@map("hs_code_master_data")
}

model LartasImpor {
  id              String           @id @default(cuid())
  status          MasterDataStatus @default(ACTIVE)
  hsCodeId        String
  hsCode          HsCodeMasterData @relation(fields: [hsCodeId], references: [id])
  apiP            Boolean          @default(false)
  apiUIndustri    Boolean          @default(false)
  apiUNonIndustri Boolean          @default(false)
  barangKonsumsi  Boolean          @default(false)
  ppbb            Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([hsCodeId])
  @@map("lartas_impor")
}

// Reference list of countries used for brand `countryOfOrigin` and other
// origin fields. `code` is ISO 3166-1 alpha-2 (e.g. "CN", "US") and unique.
model CountryMasterData {
  id        String           @id @default(cuid())
  status    MasterDataStatus @default(ACTIVE)
  name      String
  code      String           @unique
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@map("country_master_data")
}

// The Nice Classification (Klasifikasi Internasional Merek) as published on
// DJKI's Sistem Klasifikasi Merek (https://skm.dgip.go.id/) — 45 classes,
// 1-34 goods ("Barang"), 35-45 services ("Jasa"). `classNumber` is stored
// zero-padded ("01".."45") to match `Merk.trademarkClass`'s existing values.
// Seeded once from scripts/seed-trademark-classes.mjs; admin-editable from
// System Configuration > Klasifikasi Merek same as every other master data
// table (see MERK_TRADEMARK_CLASSES's removal from schema.ts for why this
// replaces the old 4-class placeholder).
model TrademarkClassMasterData {
  id          String           @id @default(cuid())
  status      MasterDataStatus @default(ACTIVE)
  classNumber String           @unique
  title       String
  category    String
  description String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("trademark_class_master_data")
}

enum AssignmentStatus {
  ASSIGNED
  SCHEDULED
  IN_PROGRESS
  SUBMITTED
  RETURNED
  COMPLETED
}

enum AssignmentPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Assignment {
  id               String             @id @default(cuid())
  assignmentNumber String             @unique
  status           AssignmentStatus   @default(ASSIGNED)
  priority         AssignmentPriority @default(MEDIUM)

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])

  surveyorId String?
  surveyor   User?   @relation("SurveyorAssignments", fields: [surveyorId], references: [id])

  verifikatorId String?
  verifikator   User?   @relation("VerifikatorAssignments", fields: [verifikatorId], references: [id])

  technicalReviewerId String?
  technicalReviewer   User?   @relation("TechnicalReviewerAssignments", fields: [technicalReviewerId], references: [id])

  // 'survey' | 'dokumen' | 'technical' — set by Customer Relation Workspace
  // when scheduling; null for legacy rows created before this field existed.
  scheduleType String?

  // Surat Tugas (assignment letter) lifecycle — draft until Customer Relation
  // submits it, pending Project Manager approval (no PM workspace exists yet).
  letterNumber String?
  letterStatus AssignmentLetterStatus @default(DRAFT)

  scheduledDate   DateTime?
  scheduledTime   String?
  dueDate         DateTime?
  location        String?
  teamMembers     Json?
  businessType    String?
  productCategory String?

  // Verifikator's desk-review layer, populated once the assignment reaches
  // SUBMITTED (all location visits completed by the surveyor). Keyed JSON
  // maps mirror the LocationVisit.checklist/findings pattern used elsewhere
  // in this schema rather than adding relational tables for what is
  // fundamentally a per-item decision map over the Application.payload
  // document/product lists.
  documentVerifications      Json?
  productVerifications       Json?
  machineVerifications       Json?
  productionQtyVerifications Json?
  // Technical Analyst's own feasibility-analysis layer (Listrik/Kapasitas/Bahan
  // Baku for VKI, Rencana/Penyimpanan/Modal for VIU) — same keyed-JSON-map
  // convention as the verifikator decision fields above, keyed by module.
  technicalAnalysisData      Json?
  validationNotes            String?
  validatedAt                DateTime?

  // Verifikator's online signature, captured when submitting the final report
  // (Draft Report tab) — signatureDate is the verifikator-chosen date printed
  // under "Disusun Oleh" on the report, distinct from validatedAt (the actual
  // submission timestamp) since the printed date may be back/forward-dated to
  // match a physical signing date.
  signaturePath String?
  signatureDate DateTime?

  // Project Manager's review of this assignment's own report (Laporan Survey
  // for scheduleType "survey", Laporan Verifikasi for "dokumen", Laporan
  // Teknis for "technical") — separate from Surat Tugas (letterStatus) and
  // from the role's own COMPLETED decision. Null until the underlying report
  // is actually ready for PM review; readiness is computed at read time
  // (project-manager-workspace), never a stored "ready" flag.
  pmReviewStatus PmReviewStatus?
  pmReviewNote   String?
  pmReviewedAt   DateTime?

  // Surat Tugas rejection reason — letterStatus itself has no REJECTED value
  // (DRAFT/PENDING/APPROVED); a PM reject reverts letterStatus to DRAFT
  // (kicks back to Customer Relation) and records why here.
  letterReviewNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  report         SurveyReport?
  locationVisits LocationVisit[]

  @@index([applicationId])
  @@index([surveyorId])
  @@index([verifikatorId])
  @@index([technicalReviewerId])
  @@map("assignment")
}

enum AssignmentLetterStatus {
  DRAFT
  PENDING
  APPROVED
}

enum PmReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LocationVisitStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model LocationVisit {
  id     String              @id @default(cuid())
  status LocationVisitStatus @default(NOT_STARTED)

  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id])

  locationType String
  address      String
  city         String?
  description  String?

  scheduledDate DateTime?
  scheduledTime String?

  checklist             Json?
  fieldObservationNotes String?
  photos                Json?
  interviews            Json?
  findings              Json?
  reportSummary         String?
  officeVerification    Json?
  warehouseVerification Json?
  factoryVerification   Json?

  // Verifikator's own desk review of the surveyor's report for this
  // location — separate from the surveyor's own checklist/findings above.
  // One JSON blob (per-item results + the final Verified/Reject/Revisi
  // decision) mirrors the existing convention for verifikator decision maps
  // elsewhere in this schema (e.g. Assignment.documentVerifications).
  reportVerification Json?

  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([assignmentId])
  @@map("location_visit")
}

enum SurveyReportStatus {
  DRAFT
  SUBMITTED
  RETURNED
  APPROVED
}

model SurveyReport {
  id     String             @id @default(cuid())
  status SurveyReportStatus @default(DRAFT)

  assignmentId String     @unique
  assignment   Assignment @relation(fields: [assignmentId], references: [id])

  checklist Json?
  evidence  Json?
  findings  Json?
  notes     String?

  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("survey_report")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// Single-row config — admin edits the copy of the printable Surat Tugas
// (assignment letter) rendered by Customer Relation and Project Manager
// Workspace, instead of it being hardcoded JSX. Always read/written via the
// fixed id below (upsert-on-read if the row doesn't exist yet).
model SuratTugasTemplate {
  id String @id @default("surat-tugas")

  // When set, the uploaded image replaces the org name/subtitle text block in the letterhead.
  headerImagePath String?
  orgName         String @default("PT Tribhakti Inspektama")
  orgSubtitle     String @default("Laboratory & Integrated Services")
  letterTitle     String @default("SURAT TUGAS")
  nomorLabel      String @default("Nomor")
  // Document-control box shown top-right of the letterhead (ISO/QHSE-style controlled
  // document metadata) — all optional, box is hidden entirely when all four are empty.
  docNumberLabel    String @default("No. Dokumen")
  docNumber         String @default("")
  docRevisionLabel  String @default("No. Terbitan")
  docRevision       String @default("")
  docAmendmentLabel String @default("No. Revisi")
  docAmendment      String @default("")
  docEffectiveLabel String @default("Berlaku Mulai")
  docEffectiveDate  String @default("")
  openingSentence String @default("Yang bertanda tangan di bawah ini, Customer Relation Workspace, dengan ini menugaskan:")
  namaLabel       String @default("Nama")
  peranLabel      String @default("Peran")
  assignmentPrefix String @default("Untuk melaksanakan")
  assignmentSuffix String @default("pada:")
  perusahaanLabel String @default("Perusahaan")
  idAplikasiLabel String @default("ID Aplikasi")
  fasilitasLabel  String @default("Fasilitas")
  tanggalLabel    String @default("Tanggal Pelaksanaan")
  closingSentence String @default("Demikian surat tugas ini dibuat untuk dilaksanakan dengan penuh tanggung jawab.")
  draftNoticeText String @default("Dokumen ini masih berupa draft dan menunggu persetujuan Project Manager sebelum berlaku resmi.")
  signatureCity   String @default("Jakarta")
  signerLabel     String @default("Customer Relation")
  // When set, the uploaded image replaces the "city, date" + signer name text block.
  footerImagePath String?
  // Optional confidentiality/distribution notice printed above the signature block —
  // supports multiple lines. Hidden entirely when empty.
  confidentialityNotice String @default("")

  updatedAt DateTime @updatedAt

  @@map("surat_tugas_template")
}

// Single-row config — admin-editable app identity (name, logo, primary color) read by
// the root layout (browser tab title) and the shared admin/login chrome. Always
// read/written via the fixed id below (upsert-on-read if the row doesn't exist yet).
// GET is intentionally public (no session check) — the login page itself needs this
// before a user is authenticated.
model BrandingSettings {
  id String @id @default("branding")

  appName              String  @default("VKI & VIU Platform")
  appSubtitle          String  @default("Sistem Verifikasi Kemampuan Industri & Verifikasi Importir Umum")
  sidebarBrandTitle    String  @default("VKI & VIU")
  sidebarBrandSubtitle String  @default("Admin Portal")
  logoPath             String?
  // Separate from `logoPath` (login/sidebar) — the letterhead mark printed on generated
  // reports. Reports are a different surface (often shared outside the app, printed) so the
  // brand mark used there is deliberately its own admin-managed asset, not forced to match.
  reportLogoPath       String?
  primaryColor           String @default("#e0662e")
  primaryColorForeground String @default("#ffffff")

  updatedAt DateTime @updatedAt

  @@map("branding_settings")
}

enum LoginSlideStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

// Admin-managed promotional slides for the right-hand panel of the login page.
// `status` is the admin's manual on/off switch; `startDate`/`endDate` are an
// optional scheduling window on top of it — a slide only actually renders on
// the login page when status is ACTIVE AND (no schedule, or now falls inside
// it). That combined check is computed at read time in the login page's own
// data-fetching code, never stored as a separate "is currently showing" flag.
model LoginSlide {
  id          String @id @default(cuid())
  imagePath   String
  label       String @default("")
  title       String
  description String @default("")
  ctaLabel    String @default("")
  ctaUrl      String @default("")
  order       Int    @default(0)

  status    LoginSlideStatus @default(DRAFT)
  startDate DateTime?
  endDate   DateTime?

  // Denormalized snapshot (same convention as `reportVerification.verifiedByName`
  // elsewhere in this schema) rather than a User relation — this is a lightweight
  // "last touched by" label, not a queryable audit log.
  updatedByName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("login_slide")
}

// Single-row config — outbound SMTP credentials the app uses to send email (e.g. via
// Hostinger's SMTP relay). Unlike `BrandingSettings`/`SuratTugasTemplate`, this holds a
// real secret (`password`), so GET is admin-only (never public) and never echoes the
// stored password back to the client — only whether one is currently set.
model SmtpSettings {
  id String @id @default("smtp")

  host     String  @default("smtp.hostinger.com")
  port     Int     @default(465)
  secure   Boolean @default(true)
  username String  @default("")
  password String  @default("")

  fromName  String @default("")
  fromEmail String @default("")
  replyTo   String @default("")

  updatedByName String?
  updatedAt     DateTime @updatedAt

  @@map("smtp_settings")
}

// Indonesian administrative region reference data (province -> city/regency -> district
// -> subdistrict/village), one row per subdistrict + its postal code. Seeded once from
// https://github.com/teguh02/Wilayah-Indonesia-Beserta-Kode-Pos (see scripts/seed-regions.mjs),
// then admin-editable from System Configuration > Data Wilayah (add/edit rows) — no
// MasterDataStatus/active-inactive toggle like the other master-data models since there's no
// notion of "inactive" region data. Flat and denormalized (not four linked tables) because
// every real consumer is a cascading-select UI that only ever filters by the parent id at
// each level, never joins across levels; admin edits to a province/city/district/subdistrict
// name cascade to every row sharing that id (see PATCH /api/system-configuration/regions/[id]).
model IndonesiaRegion {
  id              String @id @default(cuid())
  provinceId      Int
  provinceName    String
  cityId          Int
  cityName        String
  districtId      Int
  districtName    String
  // Not unique — a small number of subdistricts (~160 in the source data) legitimately
  // have more than one postal code, so this is one row per (subdistrict, postal code) pair,
  // matching the source `full.csv` exactly.
  subdistrictId   Int
  subdistrictName String
  postalCode      String

  @@index([provinceId])
  @@index([cityId])
  @@index([districtId])
  @@index([subdistrictId])
  @@map("indonesia_region")
}
